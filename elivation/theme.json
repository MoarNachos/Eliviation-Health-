	"styles": {
		"color": {
			"background": "var(--surface-page)",
			"text": "var(--text-body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"spacing": {
			"blockGap": "0px",
			"padding": {
				"top": "0px",
				"right": "0px",
				"bottom": "0px",
				"left": "0px"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "var(--wp--custom--line-height--snug)",
					"letterSpacing": "var(--wp--custom--letter-spacing--heading)"
				},
				"color": {
					"text": "var(--text-strong)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-1)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-3)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h-4)"
				}
			},
			"link": {
				"color": {
					"text": "var(--text-link)"
				},
				":hover": {
					"color": {
						"text": "var(--text-link-hover)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--action-primary)",
					"text": "var(--text-on-accent)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)",
					"width": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "17px",
					"fontWeight": "600",
					"lineHeight": "1"
				},
				"spacing": {
					"padding": {
						"top": "16px",
						"right": "28px",
						"bottom": "16px",
						"left": "28px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--action-primary-hover)"
					}
				},
				":active": {
					"color": {
						"background": "var(--action-primary-press)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
