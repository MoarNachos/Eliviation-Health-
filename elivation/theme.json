			},
			"layout": {
				"sectionY": "clamp(64px,8vw,128px)",
				"gutter": "clamp(20px,3vw,32px)",
				"pageMargin": "clamp(20px,5vw,72px)",
				"containerMax": "1280px",
				"containerText": "680px",
				"tapMin": "48px"
			},
			"motion": {
				"easeOut": "cubic-bezier(.2,.7,.2,1)",
				"easeSpring": "cubic-bezier(.34,1.4,.64,1)",
				"durFast": "140ms",
				"durBase": "220ms",
				"durSlow": "420ms"
			},
			"lineHeight": {
				"tight": "1.02",
				"snug": "1.15",
				"body": "1.55"
			},
			"letterSpacing": {
				"display": "-.035em",
				"heading": "-.02em",
				"eyebrow": ".14em"
			}
		}
